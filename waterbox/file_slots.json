{
 "_comment": "This file lists the kinds of file a project of this core can hold. Chimera's New Project window is built from it. Each kind is called a slot. A project file records its files under the slot ids used here.",
 "slots": [
  {
   "id": "cart",
   "title": "slot.cart",
   "min": 1,
   "max": 1,
   "formats": [
    "j64",
    "jag",
    "rom",
    "abs",
    "cof",
    "bin"
   ],
   "help": "slot.cart.help",
   "exposedWhen": {
    "setting": "machine",
    "is": "jaguar"
   }
  },
  {
   "id": "disc",
   "title": "slot.disc",
   "min": 1,
   "max": 1,
   "formats": [
    "cue",
    "chd",
    "cdi"
   ],
   "help": "slot.disc.help",
   "exposedWhen": {
    "setting": "machine",
    "is": "jaguarcd"
   }
  },
  {
   "id": "savedata",
   "title": "slot.savedata",
   "min": 0,
   "max": 1,
   "formats": [
    "eeprom",
    "memtrack",
    "srm",
    "sav"
   ],
   "help": "slot.savedata.help",
   "namePattern": "\\.(eeprom|memtrack|srm|sav)$",
   "nameHelp": "slot.savedata.name_help"
  }
 ]
}
