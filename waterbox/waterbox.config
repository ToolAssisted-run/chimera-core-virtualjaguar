{
 "coreName": "Virtual Jaguar",
 "systemNames": {
  "JAG": "Atari Jaguar",
  "JAGCD": "Atari Jaguar CD"
 },
 "author": "James Hammons, the Virtual Jaguar and libretro authors; chimera port by Sergio Martin",
 "url": "https://github.com/ToolAssisted-run/chimera-core-virtualjaguar",
 "romFile": "cart",
 "deterministic": true,
 "memoryLayoutMiB": [
  512,
  8,
  32,
  64,
  1024
 ],
 "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. This is room, not use: memory is taken as the machine touches it. A Jaguar has 2 MB of main memory, a cartridge is at most 6 MB.",
 "video": {
  "_comment": "The BUFFER CAPACITY: the largest picture Virtual Jaguar hands out, with the internal resolution at 2x. The live size follows the game's video mode and comes from GetVideoWidth/Height; it is shown at 4:3.",
  "width": 1440,
  "height": 1152,
  "vsyncNumerator": 60,
  "vsyncDenominator": 1,
  "_vsync_note": "The live rate comes from GetVsyncNumerator/Denominator: about 60 frames a second NTSC, 50 PAL.",
  "getBgra": "GetVideoBgra"
 },
 "audio": {
  "_comment": "Virtual Jaguar's mix, stereo, at the rate it asks for.",
  "rate": 48000,
  "samplesPerFrame": 8192,
  "channels": 2,
  "get": "GetAudio"
 },
 "lag": {
  "inputWasRead": "InputWasRead"
 },
 "settings": [
  {
   "name": "machine",
   "display": "Machine",
   "type": "enum",
   "options": [
    "jaguar",
    "jaguarcd"
   ],
   "default": "jaguar",
   "description": "'jaguar' is the console with a cartridge. 'jaguarcd' is the console with the Jaguar CD on top, for the games on CD: a .cue with its track files, a .chd or a .cdi. The CD's start-up is Virtual Jaguar's replacement; nothing has to be supplied. Everything else depends on it, so changing it restarts the core."
  },
  {
   "name": "p1_device",
   "display": "Port 1",
   "type": "enum",
   "options": [
    "pad",
    "teamtap",
    "rotary",
    "analog",
    "driving",
    "paddle",
    "6d",
    "lightgun"
   ],
   "default": "pad",
   "description": "What is plugged into port 1: a pad (P1), a Team Tap with four pads (P1, P3, P4, P5), the Tempest 2000 rotary (P1's wheel and buttons), an analog joystick or a driving controller (P1's stick, hat and A to D), the early boards' paddle input (P1's stick and pad), a 6D controller (six axes and A to G), or a light gun (P1 Gun X, Gun Y and its buttons; Gun X and Y are a fraction of the picture, as Chimera makes of the mouse's place). It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "p2_device",
   "display": "Port 2",
   "type": "enum",
   "options": [
    "pad",
    "teamtap",
    "rotary",
    "mouse_st",
    "mouse_amiga",
    "mouse_amiga_adapter",
    "analog",
    "driving",
    "paddle",
    "6d"
   ],
   "default": "pad",
   "description": "What is plugged into port 2: a pad (P2), a Team Tap with four pads (P2, P6, P7, P8), the rotary, a mouse (P2 Mouse X and Y, how far it moves in a frame, and its two buttons) through the ST adapter, an Amiga mouse through the ST adapter, or through the Amiga adapter, an analog joystick, a driving controller, the paddle input or a 6D controller. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "bios",
   "display": "Boot",
   "type": "enum",
   "options": [
    "disabled",
    "enabled"
   ],
   "default": "disabled",
   "description": "'disabled' starts the cartridge at once, through Virtual Jaguar's own replacement for the console's start-up (most games run so). 'enabled' runs the console's real boot ROM first, with its spinning cube, as the console does. The boot ROMs are built into the core. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "bios_type",
   "display": "Boot ROM",
   "type": "enum",
   "options": [
    "k",
    "m"
   ],
   "default": "k",
   "description": "Which of the console's boot ROMs, when Boot is 'enabled': 'k' is the Series K (the usual one), 'm' the Model M. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "pal",
   "display": "PAL",
   "type": "enum",
   "options": [
    "disabled",
    "enabled"
   ],
   "default": "disabled",
   "description": "'enabled' makes a PAL console (50 frames a second, as the European ones); 'disabled' an NTSC one (60). It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "usefastblitter",
   "display": "Fast Blitter",
   "type": "enum",
   "options": [
    "disabled",
    "enabled"
   ],
   "default": "disabled",
   "description": "'enabled' uses Virtual Jaguar's faster and less exact blitter. 'disabled' is the exact one. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "risc_idle_skip",
   "display": "Idle-Loop Fast-Forward",
   "type": "enum",
   "options": [
    "enabled",
    "disabled"
   ],
   "default": "enabled",
   "description": "Whether the graphics and sound processors' waiting loops are skipped in one step, as Virtual Jaguar does by default. It makes the core faster. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "internal_resolution",
   "display": "Internal Resolution",
   "type": "enum",
   "options": [
    "1x",
    "2x"
   ],
   "default": "1x",
   "description": "'2x' draws the 3D of the games that use the blitter for it at twice the size, sharper. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "true_color",
   "display": "True Color",
   "type": "enum",
   "options": [
    "disabled",
    "enabled"
   ],
   "default": "disabled",
   "description": "'enabled' draws smooth shading with more colours than the console's own format. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "widescreen",
   "display": "Widescreen",
   "type": "enum",
   "options": [
    "disabled",
    "enabled"
   ],
   "default": "disabled",
   "description": "'enabled' stretches the picture to 16:9. It changes the picture only."
  }
 ],
 "firmware": [],
 "machineSetting": "machine",
 "_controls_note": "Eight pads (P1 and P2, and P3 to P8 behind Team Taps): the pad, A, B, C, Option, Pause and the twelve keys of the keypad. Then for each port the other controllers' buttons (D to G and Rezero of the analog, driving and 6D controllers, a mouse's two buttons, a light gun's) and axes (the rotary's wheel, a mouse's movement, a stick, the 6D's other four axes, a light gun's aim). Which are live depends on the Port 1 and Port 2 settings. Both machines have the same controls.",
