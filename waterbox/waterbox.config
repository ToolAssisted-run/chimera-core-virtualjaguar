{
 "coreName": "Virtual Jaguar",
 "systemNames": {
  "JAG": "Atari Jaguar",
  "JAGCD": "Atari Jaguar CD"
 },
 "author": "James Hammons, the Virtual Jaguar and libretro authors; chimera port by Sergio Martin",
 "url": "https://github.com/ToolAssisted-run/chimera-core-virtualjaguar",
 "romFile": "cart",
 "deterministic": true,
 "memoryLayoutMiB": [
  512,
  8,
  32,
  64,
  1024
 ],
 "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. This is room, not use: memory is taken as the machine touches it. A Jaguar has 2 MB of main memory, a cartridge is at most 6 MB.",
 "video": {
  "_comment": "The BUFFER CAPACITY: the largest picture Virtual Jaguar hands out, with the internal resolution at 2x. The live size follows the game's video mode and comes from GetVideoWidth/Height; it is shown at 4:3.",
  "width": 1440,
  "height": 1152,
  "vsyncNumerator": 60,
  "vsyncDenominator": 1,
  "_vsync_note": "The live rate comes from GetVsyncNumerator/Denominator: about 60 frames a second NTSC, 50 PAL.",
  "getBgra": "GetVideoBgra"
 },
 "audio": {
  "_comment": "Virtual Jaguar's mix, stereo, at the rate it asks for.",
  "rate": 48000,
  "samplesPerFrame": 8192,
  "channels": 2,
  "get": "GetAudio"
 },
 "lag": {
  "inputWasRead": "InputWasRead"
 },
 "settings": [
  {
   "name": "machine",
   "display": "setting.machine",
   "type": "enum",
   "options": [
    "jaguar",
    "jaguarcd"
   ],
   "default": "jaguar",
   "description": "setting.machine.about"
  },
  {
   "name": "p1_device",
   "display": "setting.p1_device",
   "type": "enum",
   "options": [
    "pad",
    "teamtap",
    "rotary",
    "analog",
    "driving",
    "paddle",
    "6d",
    "lightgun"
   ],
   "default": "pad",
   "description": "setting.p1_device.about"
  },
  {
   "name": "p2_device",
   "display": "setting.p2_device",
   "type": "enum",
   "options": [
    "pad",
    "teamtap",
    "rotary",
    "mouse_st",
    "mouse_amiga",
    "mouse_amiga_adapter",
    "analog",
    "driving",
    "paddle",
    "6d"
   ],
   "default": "pad",
   "description": "setting.p2_device.about"
  },
  {
   "name": "bios",
   "display": "setting.bios",
   "type": "enum",
   "options": [
    "disabled",
    "enabled"
   ],
   "default": "disabled",
   "description": "setting.bios.about"
  },
  {
   "name": "bios_type",
   "display": "setting.bios_type",
   "type": "enum",
   "options": [
    "k",
    "m"
   ],
   "default": "k",
   "description": "setting.bios_type.about"
  },
  {
   "name": "cd_boot_mode",
   "display": "setting.cd_boot_mode",
   "type": "enum",
   "options": [
    "hle",
    "auto",
    "bios"
   ],
   "default": "hle",
   "description": "setting.cd_boot_mode.about"
  },
  {
   "name": "cd_bios_type",
   "display": "setting.cd_bios_type",
   "type": "enum",
   "options": [
    "retail",
    "dev"
   ],
   "default": "retail",
   "description": "setting.cd_bios_type.about"
  },
  {
   "name": "cd_read_speed",
   "display": "setting.cd_read_speed",
   "type": "enum",
   "options": [
    "1x",
    "2x",
    "4x",
    "8x",
    "instant"
   ],
   "default": "2x",
   "description": "setting.cd_read_speed.about"
  },
  {
   "name": "pal",
   "display": "setting.pal",
   "type": "enum",
   "options": [
    "disabled",
    "enabled"
   ],
   "default": "disabled",
   "description": "setting.pal.about"
  },
  {
   "name": "usefastblitter",
   "display": "setting.usefastblitter",
   "type": "enum",
   "options": [
    "disabled",
    "enabled"
   ],
   "default": "disabled",
   "description": "setting.usefastblitter.about"
  },
  {
   "name": "risc_idle_skip",
   "display": "setting.risc_idle_skip",
   "type": "enum",
   "options": [
    "enabled",
    "disabled"
   ],
   "default": "enabled",
   "description": "setting.risc_idle_skip.about"
  },
  {
   "name": "internal_resolution",
   "display": "setting.internal_resolution",
   "type": "enum",
   "options": [
    "1x",
    "2x"
   ],
   "default": "1x",
   "description": "setting.internal_resolution.about"
  },
  {
   "name": "true_color",
   "display": "setting.true_color",
   "type": "enum",
   "options": [
    "disabled",
    "enabled"
   ],
   "default": "disabled",
   "description": "setting.true_color.about"
  },
  {
   "name": "widescreen",
   "display": "setting.widescreen",
   "type": "enum",
   "options": [
    "disabled",
    "enabled"
   ],
   "default": "disabled",
   "description": "setting.widescreen.about"
  }
 ],
 "firmware": [],
 "machineSetting": "machine",
 "_controls_note": "Eight pads (P1 and P2, and P3 to P8 behind Team Taps): the pad, A, B, C, Option, Pause and the twelve keys of the keypad. Then for each port the other controllers' buttons (D to G and Rezero of the analog, driving and 6D controllers, a mouse's two buttons, a light gun's) and axes (the rotary's wheel, a mouse's movement, a stick, the 6D's other four axes, a light gun's aim). Which are live depends on the Port 1 and Port 2 settings. Both machines have the same controls.",
